# Serveur uniquement. Ne jamais utiliser le préfixe VITE_ pour ces variables.
APP_ORIGIN=http://localhost:5173
PORT=5173
HOST=127.0.0.1
# Identifiant de votre application Enable Banking (ce n’est pas un jeton Revolut).
ENABLE_BANKING_APP_ID=
# Clé RSA téléchargée depuis votre espace Enable Banking. Ne jamais la commiter.
ENABLE_BANKING_PRIVATE_KEY_PATH=./secrets/enablebanking.pem
# Hébergement HTTPS (Vercel) : protège les fonctions bancaires, 16 caractères minimum.
APP_PASSWORD=
# Sur Vercel, coller la clé PEM dans une variable chiffrée, pas dans un fichier du dépôt.
ENABLE_BANKING_PRIVATE_KEY=
# Redis REST via l’intégration Upstash du Marketplace Vercel (sessions chiffrées côté serveur).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# APP_ORIGIN peut être omise sur Vercel : l’URL de production fournie par Vercel sera utilisée.
